<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
 <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="10dp">
  <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="З О В  Л Е С А" android:textColor="#A4C6B4" android:textSize="9sp" android:includeFontPadding="false"/>
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Учёба" android:textStyle="bold" android:textColor="#F4F4E9" android:textSize="21sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#A4C6B4" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/study_metric" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
  <TextView android:id="@+id/study_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 / 0" android:textColor="#E4CB92" android:textSize="30sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/study_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#C6D4CB" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"/>
  <ProgressBar android:id="@+id/study_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp" android:max="1000" android:progressTint="#B9E4C6" android:progressBackgroundTint="#426453"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C6D4CB" android:textSize="12sp" android:visibility="gone"/>
 <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="Открыть трек  →" android:textColor="#B9E4C6" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
