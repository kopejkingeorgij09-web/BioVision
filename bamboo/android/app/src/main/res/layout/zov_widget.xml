<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
        <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="З О В  Л Е С А" android:textColor="#A4C6B4" android:textSize="9sp" android:includeFontPadding="false" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Дела на сегодня" android:textStyle="bold" android:textColor="#F4F4E9" android:textSize="21sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Календарь и дела" android:textColor="#A4C6B4" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="Пока нет событий" android:textColor="#C8D9CE" android:textSize="14sp" android:gravity="center_vertical" android:visibility="gone"/>
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:text="Открыть календарь  →" android:textColor="#B9E4C6" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>